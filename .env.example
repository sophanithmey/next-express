# Unified Identity Auth Configuration (Non-WSO2)
BASE_URL_UNIFIED=https://qa.wingmall.com
IDENTITY_CONSUMER_CLIENT_ID=
IDENTITY_CONSUMER_CLIENT_SECRET=
IDENTITY_RSA_PUBLIC_KEY=
IDENTITY_RSA_PADDING=pkcs1
MOCK_AUTH_API=true
MOCK_ADDRESS_API=true

# Express API (Delivery) Configuration
EXPRESS_API_BASE_URL=https://stage-api.wingbank.com/delivery/v1

# Session Security (REQUIRED in production: generate a random 32+ char secret, e.g. `openssl rand -base64 48`)
SESSION_SECRET=

# Development / Mock Mode for Delivery APIs
# Set to 'true' to use local mock adapter when upstream backend is offline or VPN-restricted
MOCK_UPSTREAM_API=true

# Tester-local browser persistence for Vercel demo deployments (stores orders, locations, and mock cards per browser)
NEXT_PUBLIC_LOCAL_DEMO_STORAGE=true

# Map Configuration (Google Maps)
NEXT_PUBLIC_MAP_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_API_KEY=
MAP_SERVER_API_KEY=


# 1. Activate Maintenance Mode
MAINTENANCE_MODE=true

# 2. (Optional) Scheduled Window / Estimated Completion Time
# Can be an ISO datetime string or human-readable format
MAINTENANCE_UNTIL="2026-11-20T04:00:00Z"

# 3. (Optional) Custom Customer Announcement Message
MAINTENANCE_MESSAGE="Core delivery booking is temporarily paused for scheduled database upgrades. Ongoing active dispatches are not affected."

# 4. (Optional) Administrator Bypass Secret Token
MAINTENANCE_BYPASS_SECRET="express_maint_bypass_secure_2026"