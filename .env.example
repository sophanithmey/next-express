# Unified Identity Auth Configuration (Non-WSO2)
BASE_URL_UNIFIED=https://qa.wingmall.com
IDENTITY_CONSUMER_CLIENT_ID=
IDENTITY_CONSUMER_CLIENT_SECRET=
IDENTITY_RSA_PUBLIC_KEY=
IDENTITY_RSA_PADDING=pkcs1
MOCK_AUTH_API=true
MOCK_ADDRESS_API=true

# Express API (Delivery) Configuration
EXPRESS_API_BASE_URL=https://stage-api.wingbank.com/delivery/v1

# Session Security (32+ characters secret for AES-256-GCM JWE encryption)
SESSION_SECRET=express_seller_secure_jwt_session_encryption_key_32_chars_min!

# Development / Mock Mode for Delivery APIs
# Set to 'true' to use local mock adapter when upstream backend is offline or VPN-restricted
MOCK_UPSTREAM_API=true

# Map Configuration (Google Maps)
NEXT_PUBLIC_MAP_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_API_KEY=
MAP_SERVER_API_KEY=
